{
  "extends": "stylelint-config-standard",
  "defaultSeverity": "warning",
  "rules": {
    "at-rule-no-unknown": [
      null,
      {
        "ignoreAtRules": [
          "if",
          "else",
          "each",
          "for",
          "function",
          "return",
          "mixin",
          "include",
          "tailwind",
          "apply",
          "layer",
          "screen"
        ]
      }
    ],
    "function-name-case": null
  }
}
